# Copy to .env. Precedence: process environment > .env > defaults. Relative paths are anchored to the repository root.
# No shell code is executed; KEY=value, quotes, inline comments and ${VAR} are supported.
# UQ_ENV_FILE=/path/to/experiment.env   # alternative file, selected in the process environment

# Data, weights and artifacts
MODELS_DIR=models
DATASETS_DIR=datasets
OUTPUT_DIR=outputs
RESULTS_DIR=results
PAPER_DIR=latex                        # LaTeX project receiving the generated tables/ and figs/
PREVIEW_DIR=artifacts/previews         # PNG previews of the figures
BUILD_DIR=artifacts/build              # TikZ build files of the framework diagram
# CONFIG_DIR=uqbench/configs           # alternative benchmark.yaml / models.yaml
HF_HOME=~/.cache/huggingface

# Credentials (never commit)
# HF_TOKEN=hf_...                      # gated datasets (GPQA)
# ANTHROPIC_API_KEY=...                # LLM-assisted labels and the black-box backbone

# Runtime. CPU analyses use three BLAS threads (bit-identical reruns).
PYTHON=python
OMP_NUM_THREADS=3
MKL_NUM_THREADS=3
OPENBLAS_NUM_THREADS=3

# Slurm submission (scripts/submit_benchmark.sh)
# SLURM_ACCOUNT=your-account
# SLURM_PARTITION=your-gpu-partition
